# ─── Server ───────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Authentication ───────────────────────────────────
# API key required by clients in the x-api-key header
API_KEY=sk-your-secret-api-key-here

# ─── Rate Limiting ────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
